<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/bottom_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Contact"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- NEW: Import from Contacts Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_import_contact"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="Import from Phone Contacts"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/bg_card_alt"
        app:icon="@drawable/ic_person"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/text_primary"
        app:shapeAppearanceOverlay="@style/FabShape" />

    <!-- Divider OR text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="OR"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Contact Name"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_contact_name"
        style="@style/VaultInputLayoutStyle"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        app:startIconDrawable="@drawable/ic_person">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:textColorHighlight="@color/white"
            android:hint="Full name"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Phone Number"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_phone_number"
        style="@style/VaultInputLayoutStyle"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        app:startIconDrawable="@drawable/ic_phone1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_phone_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:textColorHighlight="@color/white"
            android:paddingStart="40dp"
            android:inputType="phone"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Notes (Optional)"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_notes_contact"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        style="@style/VaultInputLayoutStyle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_notes_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Additional information"
            android:minLines="3"
            android:textColorHighlight="@color/white"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_contact"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/border_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_contact"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Save"
            android:textColor="@color/black"
            app:backgroundTint="@color/button_active_bg" />
    </LinearLayout>

</LinearLayout>