<?xml version="1.0" encoding="utf-8"?>
<!-- Use NestedScrollView to allow the BottomSheet to expand/collapse properly -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_dialog_background"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Bottom Sheet Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:text="Select Quality"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Warning Banner for 4K/Codec issues -->
        <LinearLayout
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="#22FFB74D"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️" />

            <TextView
                android:id="@+id/tvWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="#FFB74D"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFormatCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- RecyclerView - Height is constrained by the parent NestedScrollView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerQualities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_quality_format" />

        <TextView
            android:id="@+id/labelNoFormats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="No formats available"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>