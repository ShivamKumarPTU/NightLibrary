<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_secondary"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Credential"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ===================== -->
        <!-- TITLE FIELD -->
        <!-- ===================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Title"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_edit_title"
            style="@style/VaultInputLayoutStyle"
            app:startIconDrawable="@drawable/ic_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHighlight="@color/white"
                android:paddingStart="40dp"
                android:hint="e.g., Email, Bank Account"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================== -->
        <!-- USERNAME / EMAIL -->
        <!-- ===================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Username / Email"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_edit_main_credential"
            style="@style/VaultInputLayoutStyle"
            app:startIconDrawable="@drawable/ic_person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_edit_main_credential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="user@example.com"
                android:paddingStart="40dp"
                android:textColorHighlight="@color/white"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================== -->
        <!-- PASSWORD FIELD -->
        <!-- ===================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password / PIN"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_edit_secret"
            style="@style/VaultInputLayoutStyle"
            app:startIconDrawable="@drawable/lockicon"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_edit_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter secret"
                android:paddingStart="40dp"
                android:textColorHighlight="@color/white"
                android:inputType="textPassword"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================== -->
        <!-- NOTES -->
        <!-- ===================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notes (Optional)"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_edit_notes"
            style="@style/VaultInputLayoutStyle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_edit_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Additional information"
                android:textColorHighlight="@color/white"
                android:minLines="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================== -->
        <!-- BUTTONS -->
        <!-- ===================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_changes_button"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Save Changes"
                android:textColor="@color/black"
                app:backgroundTint="@color/button_active_bg" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>