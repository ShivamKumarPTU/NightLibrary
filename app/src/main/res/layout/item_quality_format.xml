<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Audio indicator: 🔊 / 🔇 / 🎵 -->
    <TextView
        android:id="@+id/tvAudioIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="🔊" />

    <!-- Main label: e.g. "1080p MP4" -->
    <TextView
        android:id="@+id/tvFormatLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/radioSelect"
        app:layout_constraintStart_toEndOf="@id/tvAudioIndicator"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1080p MP4" />

    <!-- Codec details: e.g. "h264 + aac" -->
    <TextView
        android:id="@+id/tvCodecInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/radioSelect"
        app:layout_constraintStart_toEndOf="@id/tvAudioIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvFormatLabel"
        tools:text="h264 + aac" />

    <!-- File size estimate -->
    <TextView
        android:id="@+id/tvFileSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/radioSelect"
        app:layout_constraintStart_toEndOf="@id/tvAudioIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvCodecInfo"
        tools:text="~45 MB" />

    <!-- Per-format device capability warning -->
    <TextView
        android:id="@+id/tvFormatWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:textColor="#FFB74D"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/radioSelect"
        app:layout_constraintStart_toEndOf="@id/tvAudioIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvFileSize"
        tools:text="⚠ May not play smoothly on this device"
        tools:visibility="visible" />

    <!-- Radio selection button -->
    <RadioButton
        android:id="@+id/radioSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>