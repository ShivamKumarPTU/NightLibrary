<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/bottom_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Credential"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Generic Title Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Title"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_title"
        style="@style/VaultInputLayoutStyle"
    android:textColorHint="@color/text_secondary"
    app:hintTextColor="@color/text_primary"
        app:startIconDrawable="@drawable/ic_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHighlight="@color/white"
            android:hint="e.g., Email, Bank Account"
            android:paddingStart="40dp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Generic Main Credential Field (for username, email, etc.) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Username / Email"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_main_credential"
        style="@style/VaultInputLayoutStyle"
        app:startIconTint="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        app:startIconDrawable="@drawable/ic_person">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_main_credential"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHighlight="@color/white"
            android:paddingStart="40dp"
            android:hint="user@example.com"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Generic Secret Field (for password, PIN, etc.) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Password / PIN"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_secret"
        style="@style/VaultInputLayoutStyle"
        app:passwordToggleEnabled="true"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        app:startIconDrawable="@drawable/lockicon">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter secret"
            android:paddingStart="40dp"
            android:textColorHighlight="@color/white"
            android:inputType="textPassword"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notes Field (Unchanged) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Notes (Optional)"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_notes_password"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="@color/text_primary"
        style="@style/VaultInputLayoutStyle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_notes_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:textColorHighlight="@color/white"
            android:hint="Additional information"
            android:minLines="3"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons (Unchanged) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_password"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/border_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_password"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Save"
            android:textColor="@color/black"
            app:backgroundTint="@color/button_active_bg" />
    </LinearLayout>

</LinearLayout>