<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    tools:context=".homeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Night Focus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/moonicon"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Night Focus"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-header: Your evening companion -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your evening companion"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Item 1: Deep Sleep -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/moonicon" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Deep Sleep" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Peaceful night rest" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 2: Focus Mode -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_focus" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Focus Mode" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Enhanced concentration" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 3: Night Reading -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nightReadingCard"
            style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        android:src="@drawable/ic_readingbook"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Night Reading" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Comfortable dark reader" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 4: Ambient Sounds -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_ambientsound" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Ambient Sounds" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Soothing soundscapes" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 5: Guided Thoughts -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_brain" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Guided Thoughts" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Mindful meditation" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>