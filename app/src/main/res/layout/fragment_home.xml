<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    tools:context=".homeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/moonicon"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="NightVault"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Secure private storage for your personal content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Item 1: Secure Photos -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/moonicon" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Secure Photos" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Encrypted private image vault" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 2: Private Videos -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_focus" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Private Videos" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Lock and play protected videos" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 3: Discreet Access -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nightReadingCard"
            style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        android:src="@drawable/ic_readingbook"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Discreet Access" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Optional alternate vault entry" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 4: Private Audio -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_ambientsound" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Private Audio" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Store music and voice files securely" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Item 5: Passwords and Contacts -->
        <com.google.android.material.card.MaterialCardView style="@style/FocusCard">

            <LinearLayout style="@style/FocusCardContent">

                <FrameLayout style="@style/FocusIconContainer">

                    <ImageView
                        style="@style/FocusIcon"
                        app:tint="@color/text_primary"
                        android:src="@drawable/ic_brain" />
                </FrameLayout>

                <LinearLayout style="@style/FocusTextContainer">

                    <TextView
                        style="@style/FocusTitle"
                        android:text="Passwords and Contacts" />

                    <TextView
                        style="@style/FocusSubtitle"
                        android:text="Protect your sensitive personal records" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
