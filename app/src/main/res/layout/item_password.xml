<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. Header Icon -->
        <FrameLayout
            android:id="@+id/password_icon_container"
            style="@style/FocusIconContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/password_service_icon"
                style="@style/FocusIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_link"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- 2. Account Info (Centered vertically with icon) -->
        <LinearLayout
            android:id="@+id/password_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/password_icon_container"
            app:layout_constraintEnd_toStartOf="@+id/contrast_button_container"
            app:layout_constraintStart_toEndOf="@+id/password_icon_container"
            app:layout_constraintTop_toTopOf="@id/password_icon_container">

            <TextView
                android:id="@+id/item_title"
                style="@style/FocusTitle"
                android:textSize="16sp"
                tools:text="Email Account" />

            <TextView
                android:id="@+id/item_subtitle"
                style="@style/FocusSubtitle"
                android:layout_marginTop="2dp"
                android:textColorHighlight="@color/white"
                android:textColor="@color/text_tertiary"
                tools:text="user@example.com" />
        </LinearLayout>

        <!-- 3. Top Right Options Menu -->
        <FrameLayout
            android:id="@+id/contrast_button_container"
            style="@style/FocusIconContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/password_more_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:contentDescription="More options"
                app:icon="@drawable/ic_threedot"
                app:iconSize="20dp"
                app:iconTint="@color/text_secondary" />
        </FrameLayout>

        <!-- 4. Password Row (Proper EditText Layout + Eye outside) -->
        <LinearLayout
            android:id="@+id/password_row_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/password_icon_container">

            <!-- THIS IS THE FIX: Using a real TextInputLayout for the password box -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_password_layout"
                style="@style/VaultInputLayoutStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="false"> <!-- We use our own external toggle -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="••••••••"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:background="@null"
                    android:textColorHighlight="@color/white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:fontFamily="monospace" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FIX: Eye Toggle Button stays OUTSIDE the box -->
            <FrameLayout
                android:id="@+id/eye_toggle_container"
                style="@style/FocusIconContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp">

                <ImageButton
                    android:id="@+id/password_visibility_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password visibility"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- 5. Bottom Description -->
        <TextView
            android:id="@+id/item_description"
            style="@style/FocusSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_muted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/password_row_container"
            tools:text="Personal email" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>