<resources xmlns:tools="http://schemas.android.com/tools"> ...your other styles...
    <!-- Base application theme. -->
    <style name="Base.Theme.NightLibrary" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.NightLibrary" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Accent Color (The color of the cursor and handles) -->
        <item name="colorPrimary">@color/nav_active</item>

        <!-- Color of the highlight background behind selected text -->
        <item name="colorControlHighlight">#4DFF9500</item>
        <!-- Specific overrides for text input -->
        <item name="android:textSelectHandle">@color/nav_active</item>
        <item name="android:textSelectHandleLeft">@color/nav_active</item>
        <item name="android:textSelectHandleRight">@color/nav_active</item>

        <!-- Cursor color -->
        <item name="android:colorControlActivated">@color/nav_active</item>
    </style>
    <style name="PinDotStyle">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/bg_pin_dot_empty</item>
    </style>


    <style name="PinButtonStyle">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">16dp</item>
        <item name="android:background">@drawable/button_background
        </item> <!-- Use your gray rounded drawable -->
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- In res/values/styles.xml or themes.xml -->
    <!-- Card Style -->
    <style name="FocusCard" parent="Widget.MaterialComponents.CardView"><item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">@color/bg_secondary</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Card Inner LinearLayout Style -->
    <style name="FocusCardContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">20dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Icon's FrameLayout container Style -->
    <style name="FocusIconContainer">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_container</item>
    </style>

    <!-- Icon ImageView Style -->
    <style name="FocusIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <!-- Container for the two text views -->
    <style name="FocusTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <!-- Title Text Style -->
    <style name="FocusTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtitle Text Style -->
    <style name="FocusSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <!-- In res/values/styles.xml or themes.xml -->

    <!-- -->


    <!-- Style for the section headers (e.g., "Privacy") -->
    <style name="SettingsSectionHeader" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Style for the main card of each setting row -->
    <style name="SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cardBackgroundColor">@color/bg_secondary</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- A container for the contents of each row to add padding -->
    <style name="SettingsRowContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- NEW: Style for the icon's FrameLayout container -->
    <style name="SettingsIconContainer">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_container</item>
    </style>

    <!-- UPDATED: Style for the setting icon (ImageView) -->
    <style name="SettingsIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <!-- Style for the LinearLayout holding the title and subtitle -->
    <style name="SettingsTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Style for the main title of a setting -->
    <style name="SettingsTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Style for the subtitle of a setting -->
    <style name="SettingsSubtitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Style for the navigation arrow -->
    <style name="SettingsArrow">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_arrow_forward</item>
        <item name="android:tint">@color/text_tertiary</item>
    </style>

    <!-- NEW AND IMPORTANT: Style for the toggle switch -->
    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Color of the circle/thumb -->
        <item name="thumbTint">@color/toggle_knob</item>
        <!-- Color of the track -->
        <item name="trackTint">@color/selector_toggle_track</item>
    </style>

    <!-- Style for the circular FrameLayout container -->
    <style name="CircularIconContainer">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_circular_icon</item>
    </style>

    <!-- Style for the bold toolbar title -->
    <style name="ToolbarTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VaultTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="FabShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <!-- In res/values/themes.xml or styles.xml -->
    <style name="SecondaryTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">@color/nav_active</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/nav_active</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabTextAppearance">@style/VaultTabTextAppearance</item>
    </style>
    <!-- In res/values/themes.xml or styles.xml -->
    <style name="VaultPrimaryTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabGravity">fill</item>
        <item name="tabIconTint">@color/selector_vault_tab_color</item>
        <item name="tabIndicatorColor">@color/nav_active</item> <!-- Color for the underline -->
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabInlineLabel">true</item>
        <item name="tabMode">fixed</item>
        <item name="tabSelectedTextColor">@color/nav_active</item>
        <item name="tabTextAppearance">@style/VaultTabTextAppearance</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <!-- THIS IS THE FIX: Removes the pink ripple/glow -->
        <item name="tabRippleColor">@null</item>
    </style>
    <!-- In res/values/styles.xml or themes.xml -->

    <!-- Style for the container of each instruction step card -->
    <style name="InstructionStepContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Style for the numbered circle (1, 2, 3) -->
    <style name="InstructionStepNumber" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Style for the vertical LinearLayout holding the title and subtitle in each step -->
    <style name="InstructionStepTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Style for the title text of each instruction step -->
    <style name="InstructionStepTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Style for the subtitle/description of each step -->
    <style name="InstructionStepSubtitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <!-- In res/values/themes.xml or styles.xml -->

    <!-- In res/values/themes.xml -->

    <!-- CORRECTED AND FINAL VERSION of the input style -->
    <style name="VaultInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>

        <!-- FIX: Change the background color to your primary, darker background -->
        <item name="boxBackgroundColor">@color/bg_primary</item>

        <!-- These properties create the rounded border -->
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/border_primary</item>
        <item name="shapeAppearanceOverlay">@style/RoundedInputShape</item>

        <!-- These properties style the icons and hint text -->
        <item name="startIconTint">@color/text_secondary</item>
        <item name="passwordToggleTint">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>


    <!-- NEW: A shape appearance style to define the corner radius -->
    <style name="RoundedInputShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <!-- CORRECTED AND FINAL VERSION of the input style -->
    <style name="mediaLinkLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>

        <!-- FIX: Change the background color to your primary, darker background -->
        <item name="boxBackgroundColor">@color/bg_secondary</item>

        <!-- These properties create the rounded border -->
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/border_primary</item>
        <item name="shapeAppearanceOverlay">@style/RoundedInputShape</item>

        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- FIX 1: Custom theme for the PopupMenu -->
    <style name="AppTheme.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <!-- Background color of the popup menu itself -->
        <item name="android:colorBackground">@color/bg_secondary</item>
        <!-- Text color for the menu items -->
        <item name="android:textColor">@color/text_primary</item>
        <!-- This is what gives the menu rounded corners -->
        <item name="popupMenuBackground">@drawable/bg_popup_menu</item>
    </style>
    <!-- Add this inside your <resources> tag in res/values/themes.xml -->
    <style name="AlertDialogTheme" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@color/bg_secondary</item>
    </style>

    <style name="TransparentDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="FullScreenDialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>


    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <!-- In your themes.xml -->
    <style name="SecureBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <!-- This ensures the window itself is secure -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>

        <!-- This points to your app's specific surface color -->
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <!-- USE YOUR APP'S ATTRIBUTES HERE -->
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearanceLargeComponent">@style/AppRoundedCorners</item>
    </style>

    <style name="AppRoundedCorners" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
